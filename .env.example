# ==============================================================================
# OMNIAGENT / NOVASPHERE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure secret keys prior to deployment.
# NEVER commit raw production secrets or master KMS keys to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omniagent_db
SPRING_DATASOURCE_USERNAME=omniagent_app
SPRING_DATASOURCE_PASSWORD=StrongDatabasePassword123!
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & RATE LIMITING (Redis 7+)
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. RABBITMQ ASYNC EVENT BUS
# ------------------------------------------------------------------------------
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=omniagent
SPRING_RABBITMQ_PASSWORD=OmniAgentRabbitMQPassword!
SPRING_RABBITMQ_VIRTUAL_HOST=/

# ------------------------------------------------------------------------------
# 5. SECURITY & ENVELOPE ENCRYPTED TOKEN VAULT
# ------------------------------------------------------------------------------
# JWT signing key (256-bit+ base64 or 64-char hex string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=14

# KMS Master Encryption Key for Hardware-Backed AES-256-GCM Token Vault
# (Must be 32 ASCII characters / 256 bits)
OMNIAGENT_KMS_MASTER_KEY=OmniAgentKmsKey2026SecureVault!
OMNIAGENT_KMS_ACTIVE_KEY_ID=kms-v1

# ------------------------------------------------------------------------------
# 6. AI PROVIDERS & MULTI-MODEL ROUTING
# ------------------------------------------------------------------------------
# Primary LLM Provider: Google Gemini
GEMINI_API_KEY=AIzaSy...YourGeminiApiKeyHere
GEMINI_PRIMARY_MODEL=gemini-1.5-pro
GEMINI_FAST_MODEL=gemini-1.5-flash

# Deterministic Fallback LLM Provider: OpenAI
OPENAI_API_KEY=sk-proj-...YourOpenAiApiKeyHere
OPENAI_PRIMARY_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 7. S3 / MINIO OBJECT STORAGE (Media Library)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123!
STORAGE_BUCKET_NAME=omniagent-media
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. PAYMENT & BILLING GATEWAYS
# ------------------------------------------------------------------------------
# International: Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Regional (Uzbekistan): Payme & Click
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 9. FRONTEND ENVIRONMENT (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=OmniAgent
NEXT_PUBLIC_DEFAULT_LANGUAGE=uz-Latn
